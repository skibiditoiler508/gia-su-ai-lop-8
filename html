<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trợ lý Gia sư AI Học tập Lớp 8 - Dự án Tin học 8</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        #chat-container::-webkit-scrollbar { width: 6px; }
        #chat-container::-webkit-scrollbar-track { background: transparent; }
        #chat-container::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 20px;
        }
        .prose-ai p { margin-bottom: 0.6rem; }
        .prose-ai p:last-child { margin-bottom: 0; }
        .prose-ai ul, .prose-ai ol {
            margin-left: 1.25rem;
            margin-bottom: 0.6rem;
            list-style-type: disc;
        }
        .prose-ai ol { list-style-type: decimal; }
        .prose-ai strong { font-weight: 700; color: #0f172a; }
        .typing-dot { animation: bounce 1.4s infinite ease-in-out both; }
        .typing-dot:nth-child(1) { animation-delay: -0.32s; }
        .typing-dot:nth-child(2) { animation-delay: -0.16s; }
        @keyframes bounce {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1); }
        }
    </style>
</head>

<body class="bg-slate-100 text-slate-800 h-screen flex flex-col overflow-hidden">

<header class="bg-white border-b border-slate-200 px-4 py-3 sm:px-6 flex items-center justify-between shadow-sm z-10">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center text-white shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
        </div>
        <div>
            <div class="flex items-center gap-2">
                <h1 class="font-bold text-base sm:text-lg text-slate-900 leading-tight">Gia sư AI Lớp 8</h1>
                <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                    Gợi mở tư duy
                </span>
            </div>
            <p class="text-xs text-slate-500">Dự án 1 · Tin học 8 • Hỗ trợ học tập có trách nhiệm</p>
        </div>
    </div>

    <button id="clear-chat-btn" onclick="openClearModal()" class="flex items-center gap-1.5 px-3 py-2 text-xs sm:text-sm font-medium text-rose-600 bg-rose-50 hover:bg-rose-100 active:scale-95 rounded-xl transition cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        <span>Xóa lịch sử</span>
    </button>
</header>

<main id="chat-container" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4 max-w-4xl w-full mx-auto"></main>

<footer class="bg-white border-t border-slate-200 p-3 sm:p-4">
    <div class="max-w-4xl mx-auto space-y-3">
        <div class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar">
            <span class="text-xs font-semibold text-slate-400 whitespace-nowrap">Gợi ý nhanh:</span>

            <button onclick="useSamplePrompt('Đừng giải ngay, hãy gợi ý từng bước suy luận để mình tự giải bài toán logic: Có 4 bạn An, Bình, Chi, Dũng xếp hàng dọc. Biết An không đứng đầu, Bình đứng ngay sau Chi, Dũng đứng cuối hàng. Hỏi thứ tự đứng của 4 bạn là gì?')" class="whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100 transition cursor-pointer">
                🧩 Gợi ý giải toán logic
            </button>

            <button onclick="useSamplePrompt('Hãy giúp mình tóm tắt 3 ý chính dễ nhớ nhất về sự khác nhau giữa biến đổi vật lí và biến đổi hóa học trong môn KHTN 8, kèm 1 câu hỏi kiểm tra nhỏ để mình tự trả lời.')" class="whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-200 hover:bg-indigo-100 transition cursor-pointer">
                📚 Tóm tắt bài học KHTN 8
            </button>

            <button onclick="useSamplePrompt('Hãy gợi ý khung lập lịch ôn thi Cuối kì I trong 10 ngày tới cho 3 môn Toán, Văn, Tiếng Anh (mỗi tối rảnh 2 tiếng, yếu Hình học) và nhắc mình cần tự điều chỉnh yếu tố sức khỏe nào.')" class="whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 transition cursor-pointer">
                📅 Lập lịch ôn thi
            </button>

            <button onclick="useSamplePrompt('Giúp mình sửa lỗi ngữ pháp đoạn văn Tiếng Anh ngắn sau và giải thích vì sao sai để mình rút kinh nghiệm: Yesterday I go to school by bike and meet my best friend.')" class="whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200 hover:bg-amber-100 transition cursor-pointer">
                ✍️ Sửa lỗi Tiếng Anh
            </button>
        </div>

        <form id="chat-form" class="flex items-end gap-2">
            <div class="flex-1 relative">
                <textarea id="user-input" rows="1" placeholder="Nhập bài tập hoặc câu hỏi bạn cần gợi ý từng bước..."
                    class="w-full resize-none rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-800 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 max-h-32 transition"></textarea>
            </div>
            <button type="submit" id="send-btn" class="p-3 rounded-2xl bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 text-white shadow-sm transition flex items-center justify-center cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
                </svg>
            </button>
        </form>

        <p class="text-[11px] text-center text-slate-400">
            Nguyên tắc đạo đức AI: Trợ lý chỉ gợi mở tư duy, không làm bài hộ • Không nhập thông tin cá nhân nhạy cảm.
        </p>
    </div>
</footer>

<div id="clear-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs hidden items-center justify-center p-4 z-50">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-xl border border-slate-100">
        <h3 class="text-lg font-bold text-slate-900 mb-2">Xóa lịch sử trò chuyện?</h3>
        <p class="text-sm text-slate-600 mb-6">Toàn bộ nội dung hỏi đáp hiện tại sẽ bị xóa khỏi màn hình để bắt đầu phiên học mới.</p>
        <div class="flex justify-end gap-2">
            <button onclick="closeClearModal()" class="px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 transition cursor-pointer">Hủy</button>
            <button onclick="confirmClearChat()" class="px-4 py-2 rounded-xl text-sm font-medium bg-rose-600 hover:bg-rose-700 text-white transition cursor-pointer">Xóa ngay</button>
        </div>
    </div>
</div>

<script>
const SYSTEM_INSTRUCTION = `Bạn là "Trợ lý Gia sư AI Học tập Lớp 8", phục vụ Dự án Tin học 8 của học sinh Việt Nam.
Nguyên tắc hoạt động BẮT BUỘC:
1. GỢI MỞ TƯ DUY, KHÔNG LÀM BÀI HỘ: Khi học sinh hỏi bài tập (Toán, Lý, Hóa, Văn, Anh, Tin...), hãy chia nhỏ vấn đề thành từng bước gợi ý và đặt câu hỏi nhỏ để học sinh tự suy nghĩ.
2. GIỌNG ĐIỆU THÂN THIỆN, SƯ PHẠM: Xưng hô "mình" và "bạn", khích lệ tinh thần tự học, giải thích ngắn gọn, dễ hiểu, trình bày rõ ràng bằng gạch đầu dòng.
3. TRUNG THỰC & MINH BẠCH: Nhắc học sinh kiểm tra lại kết quả với sách giáo khoa/thầy cô nếu là thông tin quan trọng; không bịa đặt kiến thức.`;

let chatHistory = [];
let isGenerating = false;

const chatContainer = document.getElementById('chat-container');
const chatForm = document.getElementById('chat-form');
const userInput = document.getElementById('user-input');
const sendBtn = document.getElementById('send-btn');

const welcomeMessage = {
    role: 'model',
    text: `Chào bạn! Mình là **Trợ lý Gia sư AI Học tập Lớp 8** 👋

Mình ở đây để đồng hành cùng bạn ôn bài theo nguyên tắc **"Gợi mở tư duy – Bạn làm chủ kiến thức"**:
* 🧩 Chia nhỏ bài tập khó thành **từng bước suy luận** để bạn tự tìm ra đáp án.
* 📚 Tóm tắt kiến thức trọng tâm và đặt câu hỏi kiểm tra nhanh.
* 📅 Gợi ý khung lập kế hoạch ôn tập (để bạn tự điều chỉnh theo sức khỏe thực tế).

Bạn có thể bấm vào các **nút gợi ý nhanh** bên dưới hoặc nhập câu hỏi của bạn ngay nhé!`
};

userInput.addEventListener('input', function () {
    this.style.height = 'auto';
    this.style.height = this.scrollHeight + 'px';
});

userInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        chatForm.dispatchEvent(new Event('submit'));
    }
});

function useSamplePrompt(promptText) {
    if (isGenerating) return;
    userInput.value = promptText;
    userInput.style.height = 'auto';
    userInput.style.height = userInput.scrollHeight + 'px';
    userInput.focus();
}

function renderChat() {
    chatContainer.innerHTML = '';
    appendMessageToDOM(welcomeMessage.role, welcomeMessage.text, false);
    chatHistory.forEach(msg => {
        appendMessageToDOM(msg.role, msg.parts[0].text, false);
    });
    scrollToBottom();
}

function appendMessageToDOM(role, text, shouldScroll = true) {
    const wrapper = document.createElement('div');
    wrapper.className = `flex items-start gap-3 ${role === 'user' ? 'flex-row-reverse' : ''}`;

    const avatar = document.createElement('div');
    if (role === 'user') {
        avatar.className = 'w-8 h-8 rounded-full bg-slate-800 text-white flex items-center justify-center text-xs font-bold shrink-0 mt-1';
        avatar.textContent = 'HS';
    } else {
        avatar.className = 'w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 mt-1 shadow-xs';
        avatar.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`;
    }

    const bubble = document.createElement('div');
    if (role === 'user') {
        bubble.className = 'bg-blue-600 text-white rounded-2xl rounded-tr-sm px-4 py-3 text-sm max-w-[82%] shadow-xs whitespace-pre-wrap leading-relaxed';
        bubble.textContent = text;
    } else {
        bubble.className = 'bg-white border border-slate-200 text-slate-800 rounded-2xl rounded-tl-sm px-4 py-3 text-sm max-w-[85%] shadow-xs leading-relaxed prose-ai';
        bubble.innerHTML = marked.parse(text);
    }

    wrapper.appendChild(avatar);
    wrapper.appendChild(bubble);
    chatContainer.appendChild(wrapper);

    if (shouldScroll) scrollToBottom();
}

function showTypingIndicator() {
    const wrapper = document.createElement('div');
    wrapper.id = 'typing-indicator';
    wrapper.className = 'flex items-start gap-3';
    wrapper.innerHTML = `
        <div class="w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 mt-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl rounded-tl-sm px-4 py-3.5 shadow-xs flex items-center gap-1.5">
            <span class="w-2 h-2 bg-blue-500 rounded-full typing-dot"></span>
            <span class="w-2 h-2 bg-blue-500 rounded-full typing-dot"></span>
            <span class="w-2 h-2 bg-blue-500 rounded-full typing-dot"></span>
        </div>`;
    chatContainer.appendChild(wrapper);
    scrollToBottom();
}

function removeTypingIndicator() {
    const indicator = document.getElementById('typing-indicator');
    if (indicator) indicator.remove();
}

function scrollToBottom() {
    chatContainer.scrollTop = chatContainer.scrollHeight;
}

async function fetchGeminiResponse(contents) {
    const response = await fetch('/.netlify/functions/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ contents, systemInstruction: SYSTEM_INSTRUCTION })
    });
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || 'Không thể kết nối máy chủ AI.');
    return data.reply;
}

chatForm.addEventListener('submit', async function (e) {
    e.preventDefault();
    const message = userInput.value.trim();
    if (!message || isGenerating) return;

    isGenerating = true;
    sendBtn.disabled = true;
    userInput.value = '';
    userInput.style.height = 'auto';

    appendMessageToDOM('user', message);
    chatHistory.push({ role: 'user', parts: [{ text: message }] });
    showTypingIndicator();

    try {
        const aiReply = await fetchGeminiResponse(chatHistory);
        removeTypingIndicator();
        appendMessageToDOM('model', aiReply);
        chatHistory.push({ role: 'model', parts: [{ text: aiReply }] });
    } catch (err) {
        removeTypingIndicator();
        appendMessageToDOM('model', '⚠️ Xin lỗi, kết nối tới máy chủ AI đang tạm gián đoạn. Bạn hãy thử gửi lại câu hỏi sau vài giây nhé!');
    } finally {
        isGenerating = false;
        sendBtn.disabled = false;
        userInput.focus();
    }
});

function openClearModal() {
    const modal = document.getElementById('clear-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeClearModal() {
    const modal = document.getElementById('clear-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

function confirmClearChat() {
    chatHistory = [];
    renderChat();
    closeClearModal();
}

window.onload = function () {
    renderChat();
};
</script>
</body>
</html>
